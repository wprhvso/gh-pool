POOL_SERVER=http://localhost:8000
POOL_TOKEN=change-me-worker
POOL_CLIENT_TOKEN=change-me-client

WORKER_TOKEN=change-me-worker
CLIENT_TOKEN=change-me-client

DATA_DIR=./data
BLOB_DIR=./data/blobs
DATABASE_URL=postgresql+asyncpg://pool:pool@localhost/pool
FLUSH_EVERY=0.2
EVENT_CAP=104857600
LOST_AFTER=300
LEASE_WAIT=30

SPOOL_DIR=/tmp
SPOOL_CAP=268435456
POOL_TASKS=pool.tasks
POOL_DEPS=/tmp/pool-deps
